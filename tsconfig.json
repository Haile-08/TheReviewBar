{
    "compilerOptions": {
        "target": "es5",
        "module": "esnext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "allowJs": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.js",
        "resources/js/**/*.jsx"
    ],
    "exclude": ["node_modules", "public"]
}